/// Calendar built from the ticket date range; marked as the model's date table
table Date
	lineageTag: c2e49b4e-df99-5665-af38-cd33187ce4b9
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 8f4b94d1-9680-5223-acd5-3ab28004b615
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = User

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 0847785f-3ad2-5109-9f66-392279fc0697
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = User

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7bc091a8-cad6-5456-8c27-080e7e027d75
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

		annotation SummarizationSetBy = User

	column Month
		dataType: string
		lineageTag: 4464b3a6-f993-54fc-ae3e-a45d1f10887a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

		annotation SummarizationSetBy = User

	column 'Year Month'
		dataType: dateTime
		formatString: mmm yyyy
		lineageTag: a40f57b7-882f-5222-b62a-413ff5c9cc31
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]

		annotation SummarizationSetBy = User

	column 'Week Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 0b1972cc-9ba6-5403-ac96-4cc6a2cba1fc
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Start]

		annotation SummarizationSetBy = User

	column 'Day of Week Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: d65221b7-0ed3-5303-be7e-ed460131f0b5
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day of Week Number]

		annotation SummarizationSetBy = User

	column 'Day of Week'
		dataType: string
		lineageTag: 00dd343b-61db-520e-ada1-c91ca5e3cb7b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day of Week]
		sortByColumn: 'Day of Week Number'

		annotation SummarizationSetBy = User

	partition Date = calculated
		mode: import
		source =
				VAR MinDate = MIN ( Tickets[Created Date] )
				VAR MaxDate = MAX ( Tickets[Created Date] )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( DATE ( YEAR ( MinDate ), 1, 1 ), DATE ( YEAR ( MaxDate ), 12, 31 ) ),
				        "Year", YEAR ( [Date] ),
				        "Month Number", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "MMM" ),
				        "Year Month", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				        "Week Start", [Date] - WEEKDAY ( [Date], 3 ),
				        "Day of Week Number", WEEKDAY ( [Date], 2 ),
				        "Day of Week", FORMAT ( [Date], "ddd" )
				    )

